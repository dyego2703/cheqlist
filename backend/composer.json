{
    "name": "cheqlist/backend",
    "description": "Cheqlist API",
    "type": "project",
    "require": {
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "^6.11",
        "respect/validation": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Cheqlist\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cheqlist\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/index.php",
        "test": "phpunit"
    }
}
